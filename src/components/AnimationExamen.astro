---
// Animation « l'examen en 1 minute » : SVG piloté par src/scripts/animation-examen.ts.
// Sans son, lancée au clic ; tout son contenu est repris dans le texte de la page.
const ROUGE = '#db1418';
const VERT = '#14a856';
---

<figure class="animation" data-animation-examen>
  <div class="scene-video">
    <svg viewBox="0 0 480 360" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="ae-fond" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#103a78"></stop>
          <stop offset="1" stop-color="#0a2a57"></stop>
        </linearGradient>
        <symbol id="ae-voiture" viewBox="-20 -11 40 22">
          <rect x="-15" y="-11" width="7" height="3" rx="1.5" fill="#06152b"></rect>
          <rect x="8" y="-11" width="7" height="3" rx="1.5" fill="#06152b"></rect>
          <rect x="-15" y="8" width="7" height="3" rx="1.5" fill="#06152b"></rect>
          <rect x="8" y="8" width="7" height="3" rx="1.5" fill="#06152b"></rect>
          <rect x="-18" y="-9.5" width="36" height="19" rx="6" fill={ROUGE}></rect>
          <rect x="2" y="-7" width="8" height="14" rx="2.5" fill="#dfe9f7"></rect>
          <rect x="-14" y="-6" width="5" height="12" rx="2" fill="#dfe9f7" opacity="0.7"></rect>
        </symbol>
        <symbol id="ae-coche" viewBox="-14 -14 28 28">
          <circle r="13" fill={VERT}></circle>
          <path d="M-6 0.5 -1.5 5 6.5 -4" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
        </symbol>
      </defs>
      <rect width="480" height="360" fill="url(#ae-fond)"></rect>
      <text data-a="titre" x="240" y="50" text-anchor="middle" class="t-titre">L’examen du permis B</text>

      <!-- 1. 32 minutes -->
      <g data-scene="1">
        <g data-a="cadran">
        <circle cx="240" cy="200" r="78" fill="none" stroke="rgba(255,255,255,.14)" stroke-width="14"></circle>
        <circle data-a="chrono" cx="240" cy="200" r="78" fill="none" stroke={ROUGE} stroke-width="14" stroke-linecap="round" transform="rotate(-90 240 200)" stroke-dasharray="490.1" stroke-dashoffset="490.1"></circle>
        <text data-a="minutes" x="240" y="212" text-anchor="middle" class="t-gros">0</text>
        <text x="240" y="242" text-anchor="middle" class="t-moyen">minutes</text>
        </g>
      </g>

      <!-- 2. Accueil et installation -->
      <g data-scene="2">
        <g data-a="icone-1">
          <rect x="40" y="120" width="100" height="100" rx="20" fill="rgba(255,255,255,.08)"></rect>
          <rect x="62" y="150" width="56" height="38" rx="6" fill="none" stroke="#fff" stroke-width="3"></rect>
          <circle cx="78" cy="165" r="6" fill="none" stroke="#fff" stroke-width="3"></circle>
          <path d="M92 162h18M92 172h14M70 180h40" stroke="#fff" stroke-width="3" stroke-linecap="round"></path>
          <text x="90" y="252" text-anchor="middle" class="t-petit">Identité</text>
          <use data-a="coche-1" href="#ae-coche" x="118" y="108" width="28" height="28"></use>
        </g>
        <g data-a="icone-2">
          <rect x="190" y="120" width="100" height="100" rx="20" fill="rgba(255,255,255,.08)"></rect>
          <circle cx="221" cy="174" r="14" fill="none" stroke="#fff" stroke-width="3"></circle>
          <circle cx="259" cy="174" r="14" fill="none" stroke="#fff" stroke-width="3"></circle>
          <path d="M235 172q5-5 10 0M207 170l-9-10M273 170l9-10" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"></path>
          <text x="240" y="252" text-anchor="middle" class="t-petit">Lunettes ?</text>
          <use data-a="coche-2" href="#ae-coche" x="268" y="108" width="28" height="28"></use>
        </g>
        <g data-a="icone-3">
          <rect x="340" y="120" width="100" height="100" rx="20" fill="rgba(255,255,255,.08)"></rect>
          <path d="M370 140h22a6 6 0 0 1 6 6v30h12a6 6 0 0 1 6 6v14h-46z" fill="none" stroke="#fff" stroke-width="3" stroke-linejoin="round"></path>
          <path d="M372 144 412 194" stroke={ROUGE} stroke-width="4" stroke-linecap="round"></path>
          <text x="390" y="252" text-anchor="middle" class="t-petit">Installation</text>
          <use data-a="coche-3" href="#ae-coche" x="418" y="108" width="28" height="28"></use>
        </g>
      </g>

      <!-- 3. Conduite -->
      <g data-scene="3">
        <path d="M30 300C130 300 140 170 240 175S360 300 450 235" fill="none" stroke="#294a7c" stroke-width="30" stroke-linecap="round"></path>
        <path data-a="tirets-3" d="M30 300C130 300 140 170 240 175S360 300 450 235" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="2" stroke-dasharray="10 12"></path>
        <path data-a="route-1" d="M30 300C130 300 140 170 240 175S360 300 450 235" fill="none" stroke={ROUGE} stroke-width="4" stroke-linecap="round" opacity="0.8"></path>
        <use data-a="voiture-1" href="#ae-voiture" x="-20" y="-11" width="40" height="22"></use>
        <text data-a="compteur-25" x="450" y="100" text-anchor="end" class="t-moyen">0 min</text>
      </g>

      <!-- 4. Conduite autonome -->
      <g data-scene="4">
        <path d="M20 285H460" stroke="#294a7c" stroke-width="30" stroke-linecap="round"></path>
        <path d="M210 285C260 285 300 225 325 165L345 115" fill="none" stroke="#294a7c" stroke-width="30" stroke-linecap="round"></path>
        <path data-a="tirets-4" d="M20 285H190C250 285 300 225 325 165L345 115" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="2" stroke-dasharray="10 12"></path>
        <g data-a="panneau">
          <rect x="40" y="132" width="168" height="48" rx="8" fill="#124483" stroke="#fff" stroke-width="3"></rect>
          <text x="124" y="163" text-anchor="middle" class="t-petit">Centre-ville ↗</text>
          <path d="M124 180v30" stroke="#c9d3e3" stroke-width="5"></path>
        </g>
        <path data-a="route-2" d="M20 285H190C250 285 300 225 325 165L345 115" fill="none" stroke={ROUGE} stroke-width="4" stroke-linecap="round" opacity="0.8"></path>
        <use data-a="voiture-2" href="#ae-voiture" x="-20" y="-11" width="40" height="22"></use>
        <text x="450" y="100" text-anchor="end" class="t-moyen">tout seul</text>
      </g>

      <!-- 5. Manœuvres -->
      <g data-scene="5">
        <rect x="0" y="222" width="480" height="58" fill="#294a7c"></rect>
        <g data-a="arret">
          <rect x="360" y="224" width="7" height="54" fill="#fff"></rect>
          <text x="240" y="324" text-anchor="middle" class="t-moyen">Freinage précis</text>
          <use data-a="coche-arret" href="#ae-coche" x="374" y="186" width="28" height="28"></use>
        </g>
        <g data-a="places">
          <path d="M290 90v80M340 90v80M390 90v80M440 90v80M290 90h150" stroke="#fff" stroke-width="3" fill="none"></path>
          <text x="240" y="324" text-anchor="middle" class="t-moyen">Une marche arrière</text>
        </g>
        <use data-a="voiture-3" href="#ae-voiture" x="-20" y="-11" width="40" height="22"></use>
      </g>

      <!-- 6. Vérifications -->
      <g data-scene="6">
        <g data-a="compteur-km">
          {
            ['5', '4', '7', '2', '6'].map((c, i) => (
              <g>
                <rect x={145 + i * 40} y="88" width="34" height="48" rx="7" fill={i >= 3 ? ROUGE : '#06152b'} />
                <text data-a={`chiffre-${i}`} x={162 + i * 40} y="122" text-anchor="middle" class="t-chiffre">
                  {c}
                </text>
              </g>
            ))
          }
        </g>
        <text data-a="fiche-26" x="240" y="174" text-anchor="middle" class="t-moyen">→ fiche 26</text>
        {
          [
            ['Vérification', ''],
            ['Sécurité', 'routière'],
            ['Premiers', 'secours'],
          ].map(([l1, l2], i) => (
            <g data-a={`carte-${i + 1}`}>
              <rect x={20 + i * 150} y="200" width="140" height="104" rx="16" fill="rgba(255,255,255,.1)" />
              <text x={90 + i * 150} y={l2 ? 232 : 244} text-anchor="middle" class="t-petit">
                {l1}
              </text>
              {l2 && (
                <text x={90 + i * 150} y="256" text-anchor="middle" class="t-petit">
                  {l2}
                </text>
              )}
              <text x={90 + i * 150} y="288" text-anchor="middle" class="t-point">
                +1 point
              </text>
            </g>
          ))
        }
      </g>

      <!-- 7. Pour être reçu -->
      <g data-scene="7">
        <rect x="40" y="140" width="400" height="28" rx="14" fill="rgba(255,255,255,.14)"></rect>
        <rect data-a="barre" x="40" y="140" width="0" height="28" rx="14" fill={VERT}></rect>
        <path d="M298 126v56" stroke="#fff" stroke-width="3" stroke-dasharray="5 4"></path>
        <text x="298" y="118" text-anchor="middle" class="t-petit">20</text>
        <text data-a="score" x="240" y="232" text-anchor="middle" class="t-gros">0 / 31</text>
        <g data-a="confettis-7"></g>
        <g data-a="zero-elim">
          <use href="#ae-coche" x="58" y="262" width="28" height="28"></use>
          <text x="98" y="284" class="t-moyen">et 0 erreur éliminatoire</text>
        </g>
      </g>

      <!-- 8. Résultat -->
      <g data-scene="8">
        <g data-a="telephone">
        <rect x="40" y="80" width="130" height="236" rx="22" fill="rgba(255,255,255,.06)" stroke="#fff" stroke-width="3"></rect>
        <path d="M88 96h34" stroke="#fff" stroke-width="3" stroke-linecap="round"></path>
        <text x="105" y="140" text-anchor="middle" class="t-petit">Résultat</text>
        <g data-a="favorable">
          <rect x="54" y="168" width="102" height="40" rx="10" fill="#0c7a3b"></rect>
          <text x="105" y="195" text-anchor="middle" class="t-petit">Reçu ✓</text>
        </g>
        </g>
        <g data-a="en-ligne">
          <text x="200" y="150" class="t-moyen-gras">En ligne</text>
          <text x="200" y="178" class="t-moyen">dès le lendemain</text>
        </g>
        <g data-a="cepc">
          <text x="200" y="240" class="t-moyen">Ton certificat vaut</text>
          <text x="200" y="268" class="t-moyen">permis 4 mois</text>
        </g>
        <g data-a="confettis-8"></g>
      </g>
    </svg>
    <button type="button" class="lancer" data-lancer>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
      <span>Voir l’examen en 1&nbsp;minute</span>
    </button>
  </div>
  <figcaption>
    <p class="sous-titre" data-sous-titre>L’épreuve pratique dure 32 minutes en tout.</p>
    <div class="commandes">
      <button type="button" class="bouton-icone" data-pause aria-label="Mettre en pause" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true" data-icone-pause><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"></path></svg>
        <svg viewBox="0 0 24 24" aria-hidden="true" data-icone-lecture hidden><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
      </button>
      <button type="button" class="bouton-icone" data-recommencer aria-label="Recommencer" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
      <div class="avancement" data-avancement><div></div></div>
      <span class="temps doux" data-temps>1:01</span>
    </div>
    <p class="visuellement-cache">Animation sans son. Tout son contenu est repris dans le texte de cette page.</p>
  </figcaption>
</figure>

<style>
  .animation {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .scene-video {
    position: relative;
    border-radius: var(--rayon);
    overflow: hidden;
    box-shadow: var(--ombre);
    background: #0a2a57;
  }
  .scene-video > svg {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
  }
  .scene-video :global(.t-titre) {
    font: 700 26px Poppins, system-ui, sans-serif;
    fill: #fff;
  }
  .scene-video :global(.t-gros) {
    font: 700 44px Poppins, system-ui, sans-serif;
    fill: #fff;
  }
  .scene-video :global(.t-moyen) {
    font: 500 21px Poppins, system-ui, sans-serif;
    fill: #fff;
  }
  .scene-video :global(.t-moyen-gras) {
    font: 700 24px Poppins, system-ui, sans-serif;
    fill: #fff;
  }
  .scene-video :global(.t-petit) {
    font: 600 18px Poppins, system-ui, sans-serif;
    fill: #fff;
  }
  .scene-video :global(.t-point) {
    font: 700 18px Poppins, system-ui, sans-serif;
    fill: #3dd27f;
  }
  .scene-video :global(.t-chiffre) {
    font: 700 28px Poppins, system-ui, sans-serif;
    fill: #fff;
  }
  .lancer {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--cible);
    padding: 10px 20px;
    border: 0;
    border-radius: var(--pilule);
    background: #db1418;
    color: #fff;
    font: 600 1rem Poppins, system-ui, sans-serif;
    white-space: nowrap;
    box-shadow: 0 6px 20px rgb(0 0 0 / 35%);
    cursor: pointer;
  }
  .lancer svg {
    width: 22px;
    height: 22px;
  }
  .sous-titre {
    margin: 0;
    min-height: 3.1em;
    font-weight: 600;
  }
  .commandes {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .bouton-icone {
    width: var(--cible);
    height: var(--cible);
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 2px solid var(--bordure-bouton);
    background: var(--surface);
    color: var(--texte);
    cursor: pointer;
  }
  .bouton-icone svg {
    width: 22px;
    height: 22px;
  }
  .avancement {
    flex: 1;
    height: 8px;
    border-radius: var(--pilule);
    background: var(--surface);
    border: 1px solid var(--bordure);
    overflow: hidden;
  }
  .avancement > div {
    width: 0;
    height: 100%;
    background: var(--lien);
  }
  .temps {
    font-variant-numeric: tabular-nums;
    font-size: 0.9rem;
  }
</style>
