---
import affogato400 from '../fonts/Affogato-Regular.ttf?url';
import affogato700 from '../fonts/Affogato-Bold.ttf?url';
import '../styles/global.css';
import Icone from '../components/Icone.astro';
import ChoixVoiture from '../components/ChoixVoiture.astro';
import { NOM_SITE, ECOLE, url } from '../lib/site';

interface Props {
  titre: string;
  description: string;
  actif?: 'accueil' | 'fiches' | 'entrainement' | 'examen' | null;
  noindex?: boolean;
  /** Ouvre le choix de la voiture au premier lancement. */
  demanderVoiture?: boolean;
  /** Données structurées schema.org (JSON-LD) propres à la page. */
  donneesStructurees?: Record<string, unknown>[];
}

const { titre, description, actif = null, noindex = false, demanderVoiture = true, donneesStructurees = [] } = Astro.props;
const canonique = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(url('og.png'), Astro.site).href;
const liens = [
  { id: 'accueil', href: url(), libelle: 'Accueil', icone: 'accueil' },
  { id: 'fiches', href: url('fiches/'), libelle: 'Fiches', icone: 'liste' },
  { id: 'entrainement', href: url('entrainement/'), libelle: 'S’entraîner', icone: 'cible' },
  { id: 'examen', href: url('examen/'), libelle: 'Examen blanc', icone: 'compteur' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonique} />}
    <meta name="theme-color" content="#124483" />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('icones/favicon-32.png')} />
    <link rel="apple-touch-icon" href={url('icones/apple-touch-icon.png')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Vérifs permis" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="preload" href={affogato700} as="font" type="font/ttf" crossorigin />
    <link rel="preload" href={affogato400} as="font" type="font/ttf" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={`${NOM_SITE} — ${ECOLE}`} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vérifs permis B — les 100 fiches de vérification, ECF Albi" />
    <meta name="twitter:card" content="summary_large_image" />
    {donneesStructurees.map((d) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...d })} />)}
    <noscript><style>[data-reponse][hidden]{display:flex!important}[data-sans-js]{display:none!important}</style></noscript>
  </head>
  <body data-demander-voiture={demanderVoiture ? 'oui' : undefined}>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    <header class="entete">
      <div class="bande-titre">
        <div class="entete-interieur">
          <a class="agence-logo" href={url()}>
            <img src={url('logo-ecf-contour.svg')} alt="Auto-école ECF : accueil" width="84" height="34" />
          </a>
          <a class="titre-site" href={url()}>
            <span class="titre-ligne">Vérifs permis <em>B</em></span>
            <span class="agence-nom">Picco Pechberty · Albi</span>
            <span class="visuellement-cache">, accueil</span>
          </a>
          <nav class="nav-haut" aria-label="Navigation principale">
            {liens.map((l) => <a href={l.href} aria-current={actif === l.id ? 'page' : undefined}>{l.libelle}</a>)}
          </nav>
          <button type="button" class="pastille-voiture" data-ouvrir-voiture aria-haspopup="dialog">
            <span class="pastille-icone"><Icone nom="voiture" /></span>
            <span class="pastille-texte" data-voiture-nom>Ma voiture</span>
          </button>
          <a class="appeler" href="tel:+33563540947" aria-label="Appeler l’auto-école : 05 63 54 09 47">
            <Icone nom="telephone" />
            <span class="appeler-court">Appeler</span><span class="appeler-numero">05 63 54 09 47</span>
          </a>
        </div>
      </div>
    </header>

    <main id="contenu" tabindex="-1">
      <slot />
    </main>

    <footer class="pied">
      <p>
        Questions et réponses : fiches officielles de vérification du permis B (2018).
        <a href={url('mentions-legales/')}>Mentions légales</a>
      </p>
    </footer>

    <nav class="nav-bas" aria-label="Navigation principale (mobile)">
      {
        liens.map((l) => (
          <a href={l.href} aria-current={actif === l.id ? 'page' : undefined}>
            <Icone nom={l.icone} />
            <span>{l.libelle}</span>
          </a>
        ))
      }
    </nav>

    <ChoixVoiture />
    <div id="annonce" class="visuellement-cache" aria-live="polite" aria-atomic="true"></div>

    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
