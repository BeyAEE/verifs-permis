    <h1>Mentions légales</h1>

    <section class="carte pile">
      <h2>Éditeur</h2>
      <dl>
        <dt>Raison sociale</dt>
        <dd>AUTO ECOLE PICCO PECHBERTY</dd>
        <dt>Adresse</dt>
