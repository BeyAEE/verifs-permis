---
import Base from '../../layouts/Base.astro';
import { filAriane } from '../../lib/site';
import Icone from '../../components/Icone.astro';
import '../../styles/exercices.css';
---

<Base
  titre="Examen blanc des vérifications du permis B | Vérifs permis"
  description="Passe un examen blanc des vérifications comme le jour du permis : la fiche est tirée au compteur kilométrique, 3 questions, résultat sur 3 points."
  donneesStructurees={[filAriane([['Accueil', ''], ['Examen blanc', 'examen/']])]}
  actif="examen"
>
  <div class="pile" data-examen>
    <h1>Examen blanc</h1>
    <section class="pile" data-vue="depart">
      <div class="pile intro">
        <p class="doux">Comme le jour&nbsp;J : la fiche dépend des 2 derniers chiffres du compteur. 3 questions, 1 point chacune.</p>
      </div>

      <div class="carte tirage">
        <div class="compteur" data-compteur aria-hidden="true">
          {
            Array.from({ length: 6 }, (_, i) => (
              <span class={`rouleau${i >= 4 ? ' rouleau-cle' : ''}`}>
                <span class="bande">
                  {Array.from({ length: 40 }, (_, k) => (
                    <span>{k % 10}</span>
                  ))}
                </span>
              </span>
            ))
          }
          <span class="unite">km</span>
        </div>
        <p class="tirage-resultat" data-tirage-resultat aria-live="polite"></p>
        <button type="button" class="bouton bouton-rouge bouton-geant bouton-large" data-lancer>
          <Icone nom="compteur" />Lancer le compteur
        </button>
        <button type="button" class="bouton bouton-principal bouton-geant bouton-large" data-commencer hidden>
          Commencer l’examen<Icone nom="fleche-droite" />
        </button>
      </div>

      <form class="carte saisie-compteur" data-saisie novalidate>
        <label for="deux-chiffres" class="etiquette">Tu es en voiture avec ton moniteur&nbsp;?</label>
        <p class="doux aide" id="deux-chiffres-aide">Saisis les 2 derniers chiffres du compteur kilométrique.</p>
        <div class="saisie-rangee">
          <input
            id="deux-chiffres"
            class="saisie deux-chiffres"
            type="text"
            inputmode="numeric"
            pattern="[0-9]{1,2}"
            maxlength="2"
            autocomplete="off"
            placeholder="26"
            aria-describedby="deux-chiffres-aide deux-chiffres-erreur"
          />
          <button type="submit" class="bouton bouton-principal">C’est parti</button>
        </div>
        <p class="erreur" id="deux-chiffres-erreur" data-erreur role="alert" hidden></p>
      </form>
    </section>

    <section class="pile" data-vue="question" hidden>
      <div class="barre-serie">
        <div class="barre-serie-haut">
          <p class="etiquette" data-titre-examen></p>
          <button type="button" class="lien-discret" data-abandonner aria-label="Abandonner l’examen">Abandonner</button>
        </div>
        <div class="progression" role="progressbar" aria-label="Progression de l’examen" aria-valuemin="0" aria-valuemax="3" data-progression>
          <div style="width:0%"></div>
        </div>
      </div>
      <div data-question></div>
    </section>

    <section class="pile" data-vue="resultat" hidden aria-labelledby="resultat-titre" tabindex="-1">
      <div class="carte bilan">
        <p class="surtitre" data-resultat-fiche></p>
        <h2 id="resultat-titre" class="score"><span aria-hidden="true"><span data-score>0</span><span class="sur"> / 3 points</span></span><span class="visuellement-cache" data-score-texte></span></h2>
        <p class="message" data-message></p>
      </div>
      <h2>Les bonnes réponses</h2>
      <ol class="recap" role="list" data-recap></ol>
      <div class="rangee">
        <button type="button" class="bouton bouton-rouge" data-recommencer><Icone nom="compteur" />Nouvel examen blanc</button>
        <a class="bouton bouton-contour" data-lien-fiche href="#">Voir la fiche</a>
      </div>
    </section>

    <noscript><p class="carte">L’examen blanc a besoin de JavaScript. Tu peux quand même réviser toutes les fiches depuis la liste.</p></noscript>
  </div>
</Base>

<style>
  .intro {
    gap: 8px;
  }
  .tirage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .tirage-resultat {
    min-height: 1.6em;
    font-size: 1.15rem;
    text-align: center;
  }
  .saisie-compteur {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .aide {
    font-size: 0.9rem;
  }
  .saisie-rangee {
    display: flex;
    gap: 10px;
  }
  .deux-chiffres {
    width: 96px;
    flex: 0 0 96px;
    text-align: center;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .saisie-rangee .bouton {
    flex: 1;
  }
  .erreur {
    color: var(--rouge-texte);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .barre-serie {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .barre-serie-haut {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .barre-serie-haut .lien-discret {
    padding: 0;
    white-space: nowrap;
    flex-shrink: 0;
    font-size: 0.9rem;
  }
  .barre-serie-haut .etiquette {
    text-wrap: balance;
  }
  section[data-vue='resultat']:focus {
    outline: none;
  }
</style>

<script>
  import '../../scripts/examen';
</script>
